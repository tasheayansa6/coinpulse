# ─────────────────────────────────────────────────────
# CoinPulse Server — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CoinGecko REST API
# Free tier:  https://api.coingecko.com/api/v3
# Pro tier:   https://pro-api.coingecko.com/api/v3
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional API key
# Demo plan keys start with "CG-"  → header: x-cg-demo-api-key
# Pro plan keys                    → header: x-cg-pro-api-key
COINGECKO_API_KEY=

# GeckoTerminal (no key required)
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# Redis (optional — falls back to in-memory cache if not set)
# REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
# Example: http://localhost:3000,https://yourapp.com
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
