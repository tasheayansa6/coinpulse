# ─────────────────────────────────────────────────────
# CoinPulse — Environment Variables (Next.js frontend)
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────

# ── Fastify backend URL ───────────────────────────────
# Point the Next.js frontend at the Fastify server.
# If left blank, the frontend falls back to calling CoinGecko directly.
BACKEND_URL=http://localhost:4000

# ── CoinGecko REST API ────────────────────────────────
# Free tier:  https://api.coingecko.com/api/v3
# Demo tier:  https://api.coingecko.com/api/v3   (same URL, add API key header)
# Pro tier:   https://pro-api.coingecko.com/api/v3
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional — CoinGecko API key
#   Demo plan keys start with "CG-" → header: x-cg-demo-api-key
#   Pro plan keys              → header: x-cg-pro-api-key
# Leave blank to use the public free tier (rate-limited, no key required).
COINGECKO_API_KEY=

# ── CoinGecko WebSocket (Pro/Enterprise only) ─────────
# Required for live price + trade + OHLCV streaming on the coin detail page.
# Obtain from https://www.coingecko.com/en/api/pricing
NEXT_PUBLIC_COINGECKO_WEBSOCKET_URL=wss://ws.coingecko.com/cable
NEXT_PUBLIC_COINGECKO_API_KEY=your_pro_api_key_here
